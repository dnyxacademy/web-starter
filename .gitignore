# Secrets — never commit these
.env
.env.local
.env.*.local
*.pem
*.key

# Dependencies and build output
node_modules/
dist/
build/
.next/
out/
.turbo/
coverage/
playwright-report/
test-results/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Editors and operating systems
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Data you should not commit
*.sqlite
*.sqlite3
*.csv.gz
